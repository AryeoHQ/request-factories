{
    "name": "aryeo/request-factories",
    "description": "Eloquent-style factories for building Laravel test requests.",
    "type": "library",
    "license": "proprietary",
    "repositories": {
        "tooling-laravel": {
            "type": "vcs",
            "url": "https://github.com/AryeoHQ/tooling-laravel"
        }
    },
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.37 || ^13"
    },
    "require-dev": {
        "orchestra/testbench": "^10.6 || ^11",
        "aryeo/tooling-laravel": "0.0.41",
        "orchestra/testbench-core": "^10.7 || ^11",
        "phpunit/phpunit": "^12.4.1 || ^13",
        "pestphp/pest": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Support\\": "src/Support"
        },
        "exclude-from-classmap": [
            "*Test.php",
            "*TestCases.php",
            "/tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Justin Seliga",
            "email": "justinsel@zillowgroup.com"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "aryeo/tooling-laravel": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "tooling": {
            "phpstan": { "config": { "paths": ["src", "tests/Fixtures/Support"] } },
            "rector": { "config": { "paths": ["src"] } },
            "pint": { "config": { "paths": ["src", "tests"] } }
        }
    }
}
